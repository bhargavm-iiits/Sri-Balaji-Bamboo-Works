# Server-only values. Run npm run security:setup yourself; never commit actual secrets.
PUBLIC_SITE_URL=
OWNER_PASSWORD_HASH=
OWNER_TOTP_SECRET=
ORDER_ENCRYPTION_KEY=
INDEXING_ENABLED=false
# Local access/key files are generated when development secrets are blank.
# Production requires an HTTPS origin, strong password hash, TOTP and AES key.
WHATSAPP_NOTIFICATIONS_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_OWNER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
